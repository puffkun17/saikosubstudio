{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare Workers + Vite static assets (Switch B). No vinext.
  "name": "saikosubstudio",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./workers/app/entry.ts",
  // Workers Logs (all requests sampled) + source-mapped stack traces.
  "observability": { "enabled": true, "logs": { "head_sampling_rate": 1 } },
  "upload_source_maps": true,
  "assets": {
    // @cloudflare/vite-plugin emits client assets to dist/client (verify after build).
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "none",
    // API always hits the Worker; HTML paths too so we can set CSP + no-cache.
    "run_worker_first": ["/api/*", "/", "/about", "/about/", "/feedback", "/feedback/"]
  },
  "services": [
    { "binding": "FEEDBACK_MAILER", "service": "saikosubstudio-feedback-mailer" }
  ],
  "ratelimits": [
    { "name": "FEEDBACK_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 1, "period": 60 } },
    { "name": "TMDB_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
  ]
  // Secrets: TMDB_API_KEY via `wrangler secret put` / .dev.vars — never in this file.
}
