{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare Workers (via vinext). Replaces the Pages config (pages_build_output_dir).
  // The old Pages project "saikosubstudio" is kept untouched as rollback until the domain is switched.
  "name": "saikosubstudio",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat"],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  // Same mailer Worker the Pages project used.
  "services": [
    { "binding": "FEEDBACK_MAILER", "service": "saikosubstudio-feedback-mailer" }
  ]
  // Secrets: TMDB_API_KEY must be set as a Worker secret (dashboard or `wrangler secret put TMDB_API_KEY`),
  // never in this file. Local: put it in .dev.vars (gitignored).
}
