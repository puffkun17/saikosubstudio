{
  "name": "saikosubstudio",
  "version": "5.0.0-beta.1",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node scripts/pwa/build-sw.mjs",
    "lint": "eslint .",
    "test:core": "node scripts/regression-subtitle-core.mjs",
    "preview": "npm run build && wrangler dev --config dist/saikosubstudio/wrangler.json",
    "deploy": "npm run build && wrangler deploy --config dist/saikosubstudio/wrangler.json",
    "test:unit": "node --test scripts/tests/*.test.mjs",
    "test": "npm run test:core && npm run test:unit",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:corpus": "node scripts/corpus-baseline.mjs",
    "test:corpus:record": "node scripts/corpus-baseline.mjs --record"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "figma-squircle": "^1.1.0",
    "flubber": "^0.4.2",
    "jszip": "^3.10.1",
    "libarchive.js": "^2.0.2",
    "lucide-react": "^1.17.0",
    "motion": "^14.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-use-measure": "^2.1.7",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@eslint/js": "^9",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7",
    "globals": "^16",
    "playwright": "^1.64.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vite": "^8.3.4",
    "wrangler": "^4.149.0"
  },
  "type": "module"
}
