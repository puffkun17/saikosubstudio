      "index": 12,
      "ts": "00:00:29,600 --> 00:00:31,100",
      "type": "dialogue",
      "cueKind": "screen_text",
      "method": "single-track",
      "timingSource": "secondary",
      "primaryCue": null,
      "secondaryCue": 9,
      "groupId": null,
      "text": "OPEN 9 AM - 9 PM"
    },
